# Copy to .env and fill in. Never commit the real file.

# Meta app (App Dashboard > App settings > Basic > App secret)
META_APP_SECRET=replace-with-your-app-secret
# Any long random string; enter the same value in the webhook "Verify token" field
META_VERIFY_TOKEN=replace-with-a-long-random-string
# Long-lived Page access token with leads_retrieval and pages_manage_metadata
META_PAGE_ACCESS_TOKEN=replace-with-your-page-access-token

# Bearer token for /admin endpoints (at least 16 characters)
ADMIN_TOKEN=replace-with-another-long-random-string

# Google Sheets (share the sheet with the service account e-mail as Editor)
GOOGLE_SPREADSHEET_ID=replace-with-your-spreadsheet-id

# n8n or any webhook receiver
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/facebook-leads
N8N_WEBHOOK_SECRET=replace-with-a-shared-secret

# Telegram (create a bot with @BotFather, add it to the chat)
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Public host name for Caddy (DNS A/AAAA record must point at this server)
LEADS_DOMAIN=leads.example.com
